# Optional build-time Supabase defaults.
# Copy this file to .env and fill in your project values, or leave it blank and
# connect from the Settings tab at runtime (the demo works fully offline).
#
# These are public values. Row-level security protects the data; never put a
# service_role key in an Expo app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
